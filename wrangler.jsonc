{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rag-search-demo",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/server-entry.ts",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rag-search-db",
      "database_id": "00273f4c-011c-4ac2-bd65-5a68d92aa175"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rag-search-db-product-index",
      "remote": true
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
